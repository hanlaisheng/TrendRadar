name: Auto Check In

# ✅ 自动签到 + 自愈 + 保活：每3天自动运行
# ✅ 自动启用所有被禁用的 workflow（包括自身）
# ✅ 自动创建保活 commit，防止 GitHub 60天不活跃策略禁用定时 workflow
# ✅ 完全在 GitHub 上运行，不依赖本地电脑

on:
  schedule:
    # 每3天的 UTC 00:00 执行（北京时间 08:00）
    - cron: '0 0 */3 * *'
  workflow_dispatch:  # 保留手动触发能力

jobs:
  auto-checkin:
    runs-on: ubuntu-latest
    permissions:
      actions: write
      contents: write
    steps:
      - name: Self-heal: Enable all disabled workflows
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          echo "=== 启用所有被禁用的 workflow ==="
          for wf in crawler.yml auto-checkin.yml sync-upstream.yml clean-crawler.yml; do
            echo "Enabling $wf..."
            gh api -X PUT "repos/${{ github.repository }}/actions/workflows/$wf/enable" 2>&1 || true
          done
          echo "✅ 所有 workflow 已确认启用"

      - name: Delete old workflow runs
        uses: Mattraks/delete-workflow-runs@v2
        with:
          token: ${{ github.token }}
          repository: ${{ github.repository }}
          retain_days: 0
          keep_minimum_runs: 0
          delete_workflow_by_state_pattern: "ALL"
          delete_run_by_conclusion_pattern: "ALL"

      - name: Keepalive commit (prevent GitHub 60-day inactivity disable)
        uses: actions/checkout@v4
        with:
          ref: master
          fetch-depth: 1
          token: ${{ github.token }}
      - run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          # Create an empty commit to keep the repo active
          # This prevents GitHub from disabling scheduled workflows on fork repos
          git commit --allow-empty -m "chore: keepalive - prevent inactivity disable [skip ci]" 2>&1 || true
          git push 2>&1 || true
          echo "✅ 保活 commit 已推送"

      - name: Enable Get Hot News workflow
        run: |
          # 确保 crawler workflow 处于启用状态
          curl -s -X PUT \
            -H "Authorization: token ${{ github.token }}" \
            -H "Accept: application/vnd.github+json" \
            "https://api.github.com/repos/${{ github.repository }}/actions/workflows/crawler.yml/enable"
          echo "✅ Get Hot News workflow 已确认启用"

      - name: Verify workflow status
        run: |
          echo "=== Workflow 状态 ==="
          curl -s -H "Authorization: token ${{ github.token }}" \
            "https://api.github.com/repos/${{ github.repository }}/actions/workflows" | \
            python3 -c "
          import sys,json
          data = json.load(sys.stdin)
          for w in data['workflows']:
              print(f\"  {w['name']}: {w['state']}\")
          "

          echo ""
          echo "=== 最新 Run ==="
          curl -s -H "Authorization: token ${{ github.token }}" \
            "https://api.github.com/repos/${{ github.repository }}/actions/runs?per_page=1" | \
            python3 -c "
          import sys,json
          data = json.load(sys.stdin)
          r = data['workflow_runs'][0]
          print(f\"  Workflow: {r['name']}\")
          print(f\"  Event: {r['event']}\")
          print(f\"  Status: {r['status']}\")
          "
